// ==========================================================================
// Schéma de données — Plateforme multi-tenant de gestion de projets ONG
// Référentiel comptable : SYCEBNL (OHADA)
// ==========================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------- Multi-tenant / Comptes ----------------

model Organization {
  id                 String   @id @default(uuid())
  name               String
  type               String   // "ONG", "Bailleur", "Prestataire", ...
  country            String?
  address            String?  // adresse complète (siège), imprimée sur les documents officiels
  registrationNumber String?  // N° d'agrément / récépissé
  taxId              String?  // NIF / numéro d'identification fiscale, si applicable
  phone              String?
  email              String?
  website            String?
  bankName           String?  // compte par défaut (rétrocompatibilité) — préférer bankAccounts pour une ONG à plusieurs comptes
  bankAddress        String?
  bankAccountNumber  String?
  bankAccounts       BankAccount[]
  logoUrl            String?  // logo (data URL base64 ou lien hébergé) imprimé sur bulletins, factures, TDR...
  createdAt          DateTime @default(now())

  users        Membership[]
  projects     Project[]
  staff        Staff[]
  letterTemplates LetterTemplate[]
  auditLogs       AuditLog[]
  exchangeRates   ExchangeRate[]
  suppliers    Supplier[]
  accounts     ChartOfAccount[]
  documents    Document[]
  warehouses   Warehouse[]
  vehicles     Vehicle[]
  drivers      Driver[]
  invoices     Invoice[]
  payments     Payment[]
  assets       Asset[]
  notifications Notification[]
  invitations  Invitation[]
  bankStatementLines BankStatementLine[]
  consumableRequests ConsumableRequest[]
  programs           Program[]
  partneredProjects  ProjectPartner[]
  sharedResources    SharedResource[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships        Membership[]
  projectMemberships ProjectMembership[]
  ownedActivities    Activity[]
  createdExpenses    Expense[]
  authoredDocuments  Document[]
  invitationsSent    Invitation[]
  validatedOrders    PurchaseOrder[]
  registeredSupplierInvoices SupplierInvoice[]
}

// Un utilisateur peut appartenir à plusieurs organisations avec des rôles différents
model Membership {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  role           Role
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

// Invitation d'un collaborateur à rejoindre une organisation avec un rôle
// donné (cf. cahier des charges §2.1 — seul l'Admin/Président peut inviter).
// L'invité peut déjà avoir un compte utilisateur (autre organisation) ou non ;
// dans les deux cas, accepter l'invitation crée simplement le Membership
// correspondant.
model Invitation {
  id             String           @id @default(uuid())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String
  email          String
  role           Role
  token          String           @unique
  status         InvitationStatus @default(EN_ATTENTE)
  invitedBy      User             @relation(fields: [invitedById], references: [id])
  invitedById    String
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
}

enum InvitationStatus {
  EN_ATTENTE
  ACCEPTEE
  EXPIREE
  REVOQUEE
}

enum Role {
  ADMIN
  CHEF_PROJET
  COMPTABLE
  LOGISTICIEN
  RH
  MEMBRE
  PARTENAIRE_EXTERNE
  BAILLEUR_LECTURE
}

// Rattachement d'un utilisateur à un projet précis, avec un rôle et une
// PORTÉE D'ACCÈS propres à ce projet (indépendants de son rôle organisationnel
// global). C'est ce qui distingue l'espace personnel (COMPLET vs PERSONNEL)
// — cf. cahier des charges §2.1.1. L'Admin/Président de l'organisation n'a
// pas besoin d'entrée ici : il a toujours accès complet, vérifié directement
// via son Membership.role === ADMIN dans le middleware d'accès.
model ProjectMembership {
  id        String        @id @default(uuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  project   Project       @relation(fields: [projectId], references: [id])
  projectId String
  role      ProjectRole   @default(MEMBRE)
  scope     AccessScope   @default(PERSONNEL)
  createdAt DateTime      @default(now())

  @@unique([userId, projectId])
}

enum ProjectRole {
  RESPONSABLE   // chef de projet sur ce projet précis — accès complet par défaut
  MEMBRE
  PARTENAIRE
  LECTURE_SEULE
}

enum AccessScope {
  COMPLET     // voit tout le projet
  PERSONNEL   // ne voit que ce qui lui est propre (activités assignées, dépenses saisies, documents dont il est l'auteur)
}

// ---------------- Projets & Planification ----------------

model Program {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  projects       Project[]
}

model Project {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  program        Program?     @relation(fields: [programId], references: [id])
  programId      String?
  name           String
  code           String       @unique
  donor          String
  grantNumber    String?      // N° de subvention attribué par le bailleur (ex. 0213947-G-2017-002-00)
  currency       String       @default("GNF")
  totalBudget    Decimal
  startDate      DateTime
  endDate        DateTime
  status         ProjectStatus @default(EN_COURS)

  logframe       LogframeResult[]
  activities     Activity[]
  budgetLines    BudgetLine[]
  purchaseOrders PurchaseOrder[]
  assignments    Assignment[]
  documents      Document[]
  paymentRequests PaymentRequest[]
  sharedWith     ProjectPartner[]
  stockItems     StockItem[]
  vehicleAssignments VehicleProjectAssignment[]
  trips          Trip[]
  invoices       Invoice[]
  payments       Payment[]
  memberships    ProjectMembership[]
  assets         Asset[]
  notifications  Notification[]
  journalEntries JournalEntry[]
}

enum ProjectStatus {
  PLANIFICATION
  EN_COURS
  SUSPENDU
  CLOTURE
}

// Organisations partenaires invitées sur un projet (collaboration inter-ONG)
model ProjectPartner {
  id             String       @id @default(uuid())
  project        Project      @relation(fields: [projectId], references: [id])
  projectId      String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  invitedAt      DateTime     @default(now())

  @@unique([projectId, organizationId])
}

model LogframeResult {
  id          String   @id @default(uuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  objective   String
  result      String
  indicator   String
  target      Float
  achieved    Float    @default(0)
}

model Activity {
  id            String      @id @default(uuid())
  project       Project     @relation(fields: [projectId], references: [id])
  projectId     String
  title         String
  startDate     DateTime
  endDate       DateTime
  progressPct   Int         @default(0)
  status        String      @default("À faire")
  owner         User?       @relation(fields: [ownerId], references: [id]) // utilisateur responsable — sert de filtre pour l'espace personnel
  ownerId       String?
  // Planification budgétaire : toute activité planifiée avec un coût doit
  // être rattachée à une ligne budgétaire précise du projet — le coût ne
  // peut pas dépasser silencieusement le disponible de cette ligne.
  budgetLine    BudgetLine? @relation(fields: [budgetLineId], references: [id])
  budgetLineId  String?
  estimatedCost Decimal?
}

// ---------------- Finances & Comptabilité (SYCEBNL) ----------------

model BudgetLine {
  id          String   @id @default(uuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  code        String   // ex. "61" (classe SYCEBNL)
  label       String
  allocated   Decimal
  spent       Decimal  @default(0)

  expenses       Expense[]
  disbursements  Disbursement[]
  purchaseOrders PurchaseOrder[]
  fuelLogs       FuelLog[]
  maintenances   Maintenance[]
  payments       Payment[]
  assetMaintenances AssetMaintenance[]
  activities        Activity[]
  journalEntries JournalEntry[]
}

// Plan comptable SYCEBNL propre à chaque organisation
model ChartOfAccount {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  classNumber    Int          // 1 à 8 (classes SYCEBNL)
  accountCode    String       // ex. "601"
  label          String

  journalEntries JournalEntry[]

  @@unique([organizationId, accountCode])
}

model JournalEntry {
  id          String          @id @default(uuid())
  account     ChartOfAccount  @relation(fields: [accountId], references: [id])
  accountId   String
  project     Project?        @relation(fields: [projectId], references: [id])
  projectId   String?
  budgetLine  BudgetLine?     @relation(fields: [budgetLineId], references: [id])
  budgetLineId String?
  date        DateTime        @default(now())
  debit       Decimal         @default(0)
  credit      Decimal         @default(0)
  label       String
  sourceType  JournalSource   // origine de l'écriture
  sourceId    String?         // id de la dépense / décaissement / livraison liée
  syncStatus  SyncStatus      @default(SYNCED) // gestion du mode hors-ligne
  entryGroup  String?         // regroupe les lignes d'une même écriture manuelle en partie double
  createdById String?         // utilisateur ayant saisi l'écriture (MANUEL) — traçabilité
  // Rapprochement bancaire : une écriture de trésorerie (classe 5) est
  // rapprochée une fois retrouvée sur le relevé bancaire correspondant.
  reconciled     Boolean            @default(false)
  reconciledAt   DateTime?
  bankStatementLine   BankStatementLine? @relation(fields: [bankStatementLineId], references: [id])
  bankStatementLineId String?            @unique
}

enum JournalSource {
  DEPENSE
  DECAISSEMENT
  LIVRAISON
  MANUEL
}

// Ligne de relevé bancaire saisie (manuellement ou importée) pour le
// rapprochement : chaque ligne est éventuellement mise en correspondance
// avec UNE écriture de trésorerie (JournalEntry.bankStatementLineId).
model BankStatementLine {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  date           DateTime
  label          String
  amount         Decimal       // positif = crédit banque (entrée), négatif = débit banque (sortie)
  reference      String?
  matched        JournalEntry?
  createdAt      DateTime      @default(now())
}

enum SyncStatus {
  SYNCED
  PENDING_SYNC
  CONFLICT
}

model Expense {
  id           String     @id @default(uuid())
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id])
  budgetLineId String
  label        String
  amount       Decimal
  date         DateTime   @default(now())
  status       ExpenseStatus @default(EN_ATTENTE_JUSTIFICATIF)
  syncStatus   SyncStatus @default(SYNCED)
  createdBy    User?      @relation(fields: [createdById], references: [id]) // sert de filtre pour l'espace personnel
  createdById  String?
}

enum ExpenseStatus {
  ENGAGE
  DECAISSE
  EN_ATTENTE_JUSTIFICATIF
  JUSTIFIE
}

model Disbursement {
  id           String     @id @default(uuid())
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id])
  budgetLineId String
  amount       Decimal
  date         DateTime   @default(now())
  method       String     // "Virement", "Espèces", "Mobile money"...
  syncStatus   SyncStatus @default(SYNCED)
}

// ---------------- Logistique / Achats ----------------

model Supplier {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  contact        String?

  purchaseOrders PurchaseOrder[]
  payments       Payment[]
}

model PurchaseOrder {
  id                String       @id @default(uuid())
  project           Project      @relation(fields: [projectId], references: [id])
  projectId         String
  budgetLine        BudgetLine   @relation(fields: [budgetLineId], references: [id])
  budgetLineId      String
  supplier          Supplier     @relation(fields: [supplierId], references: [id])
  supplierId        String
  item              String
  amount            Decimal
  status            OrderStatus  @default(EN_ATTENTE_VALIDATION)
  createdAt         DateTime     @default(now())
  // Validation par le Président/Admin — obligatoire avant toute livraison
  validatedById     String?
  validatedBy       User?        @relation(fields: [validatedById], references: [id])
  validatedAt       DateTime?
  rejectionReason   String?      // motif si le Président refuse la commande
  // Réception de la livraison (bon de livraison physique reçu du fournisseur)
  deliveredAt       DateTime?
  deliveryNoteRef   String?      // référence du bon de livraison papier reçu
  // Facture fournisseur — reçue par le Comptable, condition du paiement
  supplierInvoice   SupplierInvoice?
}

enum OrderStatus {
  EN_ATTENTE_VALIDATION // passée par la Logistique, en attente du Président
  REJETEE               // refusée par le Président (voir rejectionReason)
  VALIDEE               // validée par le Président — la commande peut être envoyée au fournisseur
  LIVREE                // bon de livraison + marchandise reçus
  FACTURE_RECUE         // facture fournisseur enregistrée par le Comptable, prête pour paiement
  COMPTABILISEE         // payée et comptabilisée
}

// Facture fournisseur reçue en contrepartie d'une commande livrée — distincte
// de `Invoice` (les factures que l'ONG ÉMET). Le Comptable ne peut déclencher
// le paiement qu'une fois cette facture enregistrée, conformément au cycle :
// Logistique commande → Président valide → Livraison (BL) → Facture reçue
// (Comptable) → Paiement.
model SupplierInvoice {
  id              String        @id @default(uuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String        @unique
  invoiceNumber   String        // numéro de facture du fournisseur (pas le nôtre)
  amount          Decimal
  receivedAt      DateTime      @default(now())
  registeredById  String?
  registeredBy    User?         @relation(fields: [registeredById], references: [id])
  status          SupplierInvoiceStatus @default(RECUE)
}

enum SupplierInvoiceStatus {
  RECUE
  PAYEE
}

// ---------------- Facturation ----------------

model Invoice {
  id             String        @id @default(uuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  project        Project?      @relation(fields: [projectId], references: [id])
  projectId      String?
  number         String        // numérotation séquentielle, unique par organisation
  clientName     String        // partenaire/client facturé pour la prestation
  currency       String        @default("GNF")
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(EMISE)

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([organizationId, number])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId   String
  description String  // prestation facturée
  quantity    Decimal @default(1)
  unitPrice   Decimal
}

enum InvoiceStatus {
  EMISE
  ENVOYEE
  PAYEE
  EN_RETARD
  ANNULEE
}

// ---------------- Paiements multicanal ----------------
// Modèle générique pour tout paiement sortant (fournisseur, prestataire, salaire)
// ou entrant (encaissement d'une facture émise), quel que soit le canal utilisé.

model Payment {
  id             String           @id @default(uuid())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String
  project        Project?         @relation(fields: [projectId], references: [id])
  projectId      String?
  budgetLine     BudgetLine?      @relation(fields: [budgetLineId], references: [id])
  budgetLineId   String?
  direction      PaymentDirection
  method         PaymentMethod
  amount         Decimal
  reference      String?          // n° de transaction mobile money / référence de virement
  status         PaymentStatus    @default(CONFIRME)
  date           DateTime         @default(now())
  syncStatus     SyncStatus       @default(SYNCED)

  // Origine du paiement (une seule de ces relations est renseignée selon le cas)
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId     String?
  staff          Staff?           @relation(fields: [staffId], references: [id])
  staffId        String?
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  invoiceId      String?
  payslip        Payslip?         @relation(fields: [payslipId], references: [id])
  payslipId      String?
}

enum PaymentDirection {
  SORTANT // l'organisation paie (fournisseur, prestataire, salaire)
  ENTRANT // l'organisation encaisse (règlement d'une facture émise)
}

enum PaymentMethod {
  VIREMENT
  ORANGE_MONEY
  MTN_MONEY
  MOOV_MONEY
  WAVE
  ESPECES
  CHEQUE
}

enum PaymentStatus {
  INITIE
  CONFIRME
  ECHOUE
}

// ---------------- Gestion des stocks ----------------

model Warehouse {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  location       String?

  stockItems StockItem[]
}

model StockItem {
  id          String       @id @default(uuid())
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  warehouseId String
  project     Project?     @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  unit        String       // "kg", "unité", "litre", ...
  quantity    Decimal      @default(0)
  minQuantity Decimal      @default(0) // seuil d'alerte
  unitCost    Decimal      @default(0)

  movements StockMovement[]
}

model StockMovement {
  id          String       @id @default(uuid())
  stockItem   StockItem    @relation(fields: [stockItemId], references: [id])
  stockItemId String
  type        MovementType
  quantity    Decimal
  reason      String?      // ex. "Réception CMD-001", "Distribution activité X"
  date        DateTime     @default(now())
}

enum MovementType {
  ENTREE
  SORTIE
  TRANSFERT
}

// ---------------- Parc de véhicules ----------------

model Vehicle {
  id             String        @id @default(uuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  type           VehicleType   @default(VOITURE) // voiture, moto, engin lourd (tracteur, groupe mobile...)
  plateNumber    String        @unique
  brand          String
  model          String
  acquiredAt     DateTime?
  status         VehicleStatus @default(DISPONIBLE)
  currentMileage Int           @default(0) // pour un ENGIN sans compteur km, utiliser les heures moteur (champ engineHours)
  engineHours    Int?          // pertinent pour les engins (tracteurs, groupes électrogènes mobiles...) plutôt que le km

  // Affectation permanente d'un chauffeur (employé) à ce véhicule/moto/engin —
  // distincte du chauffeur d'un trajet ponctuel (Trip.driverId), qui peut
  // exceptionnellement différer (remplacement, alternance...).
  assignedDriver   Driver? @relation(fields: [assignedDriverId], references: [id])
  assignedDriverId String?

  trips        Trip[]
  fuelLogs     FuelLog[]
  maintenances Maintenance[]
  assignments  VehicleProjectAssignment[]
}

enum VehicleType {
  VOITURE
  MOTO
  ENGIN
  AUTRE
}

enum VehicleStatus {
  DISPONIBLE
  EN_MISSION
  EN_MAINTENANCE
  HORS_SERVICE
}

// Affectation d'un véhicule à un ou plusieurs projets (usage partagé)
model VehicleProjectAssignment {
  id        String  @id @default(uuid())
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  sharePct  Int     @default(100) // répartition du coût si usage partagé entre projets
}

// ---------------- Chauffeurs ----------------

// Un chauffeur EST un employé de l'organisation — pas une fiche à part.
// Le lien vers Staff est donc obligatoire (pas de chauffeur "hors RH") ;
// l'identité (nom, contact) provient de Staff, jamais dupliquée ici.
model Driver {
  id                String       @id @default(uuid())
  organization      Organization @relation(fields: [organizationId], references: [id])
  organizationId    String
  staff             Staff        @relation(fields: [staffId], references: [id])
  staffId           String       @unique // un employé ne peut avoir qu'une seule fiche chauffeur
  licenseNumber     String
  licenseExpiryDate DateTime

  trips Trip[]
  assignedVehicles Vehicle[]
}

// ---------------- Déplacements (carnet de bord) ----------------

model Trip {
  id             String    @id @default(uuid())
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  vehicleId      String
  driver         Driver    @relation(fields: [driverId], references: [id])
  driverId       String
  project        Project?  @relation(fields: [projectId], references: [id])
  projectId      String?
  purpose        String
  route          String?
  startMileage   Int
  endMileage     Int?
  departureDate  DateTime
  returnDate     DateTime?
}

// ---------------- Carburant ----------------

model FuelLog {
  id           String     @id @default(uuid())
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id])
  vehicleId    String
  budgetLine   BudgetLine? @relation(fields: [budgetLineId], references: [id])
  budgetLineId String?
  date         DateTime   @default(now())
  liters       Decimal
  cost         Decimal
  mileage      Int        // kilométrage au moment du plein
  syncStatus   SyncStatus @default(SYNCED)
}

// ---------------- Maintenance ----------------

model Maintenance {
  id           String          @id @default(uuid())
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id])
  vehicleId    String
  budgetLine   BudgetLine?     @relation(fields: [budgetLineId], references: [id])
  budgetLineId String?
  type         MaintenanceType
  date         DateTime        @default(now())
  mileage      Int
  provider     String?
  description  String?
  cost         Decimal
  nextDueDate  DateTime?       // prochaine échéance (préventive)
  nextDueKm    Int?
}

enum MaintenanceType {
  PREVENTIVE
  CURATIVE
}

// ---------------- Matériel divers (informatique et autres équipements) ----------------
// Registre générique pour tout ce qui n'est pas un véhicule/moto : PC,
// imprimantes, groupes électrogènes, etc. — cf. cahier des charges §2.5.7bis.

model Asset {
  id             String        @id @default(uuid())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  project        Project?      @relation(fields: [projectId], references: [id])
  projectId      String?
  category       AssetCategory
  name           String        // ex. "PC portable — bureau Niamey", "Groupe électrogène 5kVA"
  serialNumber   String?
  acquiredAt     DateTime?
  warrantyEnd    DateTime?
  status         AssetStatus   @default(EN_SERVICE)

  maintenances AssetMaintenance[]
}

enum AssetCategory {
  INFORMATIQUE
  GENERATEUR
  MOBILIER_BUREAU
  EQUIPEMENT_TERRAIN
  AUTRE
}

enum AssetStatus {
  EN_SERVICE
  EN_MAINTENANCE
  HORS_SERVICE
  REFORME
}

model AssetMaintenance {
  id           String              @id @default(uuid())
  asset        Asset               @relation(fields: [assetId], references: [id])
  assetId      String
  budgetLine   BudgetLine?         @relation(fields: [budgetLineId], references: [id])
  budgetLineId String?
  type         AssetMaintenanceType
  date         DateTime            @default(now())
  provider     String?
  description  String?             // ex. "Renouvellement licence antivirus 1 an"
  cost         Decimal             @default(0)
  nextDueDate  DateTime?           // prochaine échéance (entretien préventif ou renouvellement de licence)
}

enum AssetMaintenanceType {
  PREVENTIVE
  CURATIVE
  RENOUVELLEMENT_LICENCE // ex. antivirus, logiciel sous abonnement
}

// ---------------- Alertes / Notifications ----------------
// Alerte générée pour toute échéance de maintenance (véhicule, moto, ou
// matériel divers) approchant ou dépassée, notifiée en priorité au
// Logisticien et à l'Admin/Président — cf. cahier des charges §2.5.7ter.

model Notification {
  id             String               @id @default(uuid())
  organization   Organization         @relation(fields: [organizationId], references: [id])
  organizationId String
  project        Project?             @relation(fields: [projectId], references: [id]) // renseigné pour une panne : le(s) projet(s) impacté(s)
  projectId      String?
  type           NotificationType
  message        String
  dueAt          DateTime             // date/échéance concernée par l'alerte
  urgency        NotificationUrgency
  resourceType   String               // "Vehicle" | "Asset"
  resourceId     String               // id du véhicule ou du matériel concerné
  status         NotificationStatus   @default(EN_ATTENTE)
  createdAt      DateTime             @default(now())
  acknowledgedAt DateTime?

  @@unique([resourceType, resourceId, type, dueAt])
}

enum NotificationType {
  MAINTENANCE_VEHICULE
  MAINTENANCE_MATERIEL
  RENOUVELLEMENT_LICENCE
  PANNE_VEHICULE
}

enum NotificationUrgency {
  A_VENIR     // échéance dans plus de 15 jours / 1000 km
  IMMINENTE   // échéance sous 15 jours / 1000 km
  DEPASSEE
}

enum NotificationStatus {
  EN_ATTENTE
  TRAITEE
}

// ---------------- Ressources Humaines ----------------

model Staff {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  fullName       String
  jobTitle       String
  monthlyCost    Decimal
  email          String?
  phone          String?      // utilisé pour le partage du bulletin de paie via WhatsApp
  address        String?      // adresse personnelle, imprimée sur le bulletin de paie
  nationalId     String?      // n° de carte d'identité / passeport
  hireDate       DateTime?    // date d'embauche
  endDate        DateTime?    // date de fin de contrat, le cas échéant
  contractType   ContractType @default(CDI)
  category       String?      // catégorie professionnelle / classification (utile pour la paie)
  cnssNumber     String?      // n° d'immatriculation sécurité sociale (CNSS ou équivalent national)
  status         StaffStatus  @default(ACTIF)

  assignments Assignment[]
  payments    Payment[]
  payslips    Payslip[]
  driverProfile Driver?
  leaveRequests LeaveRequest[]
  consumableRequests ConsumableRequest[]
}

enum ContractType {
  CDI
  CDD
  PRESTATION
  STAGE
  BENEVOLE
}

enum StaffStatus {
  ACTIF
  SUSPENDU
  SORTI // fin de contrat / démission / licenciement
}

// Demande de congé d'un employé — véritable outil RH au-delà de la simple fiche de paie.
model LeaveRequest {
  id          String            @id @default(uuid())
  staff       Staff             @relation(fields: [staffId], references: [id])
  staffId     String
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveRequestStatus @default(EN_ATTENTE)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())
}

enum LeaveType {
  CONGE_ANNUEL
  MALADIE
  MATERNITE_PATERNITE
  SANS_SOLDE
  AUTRE
}

enum LeaveRequestStatus {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

// Demande de consommables/fournitures par un employé — point d'entrée du
// cycle logistique côté "besoin terrain" : une fois approuvée, elle peut
// être servie depuis le stock existant (sortie) ou déclencher une commande
// fournisseur si le stock est insuffisant.
model ConsumableRequest {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  requestedBy    Staff                  @relation(fields: [staffId], references: [id])
  staffId        String
  projectId      String?
  itemName       String
  quantity       Decimal
  unit           String
  justification  String?
  status         ConsumableRequestStatus @default(EN_ATTENTE)
  approvedById   String?
  approvedAt     DateTime?
  fulfilledFromStockItemId String?       // si servi depuis un article de stock existant
  createdAt      DateTime               @default(now())
}

enum ConsumableRequestStatus {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
  SERVIE_STOCK      // servie directement depuis le stock disponible
  COMMANDE_REQUISE  // stock insuffisant, une commande fournisseur est nécessaire
}

model Assignment {
  id        String  @id @default(uuid())
  staff     Staff   @relation(fields: [staffId], references: [id])
  staffId   String
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  allocPct  Int     // taux d'affectation (%)
  startDate DateTime
  endDate   DateTime?
}

// ---------------- Paie ----------------

model Payslip {
  id           String    @id @default(uuid())
  staff        Staff     @relation(fields: [staffId], references: [id])
  staffId      String
  period       String    // format "YYYY-MM"
  baseSalary   Decimal
  bonuses      Decimal   @default(0)   // total des primes (dérivé des lignes PayslipLine BONUS)
  deductions   Decimal   @default(0)   // total des retenues (dérivé des lignes PayslipLine DEDUCTION)
  netPay       Decimal   // baseSalary + bonuses - deductions
  status       PayslipStatus @default(GENERE)
  generatedAt  DateTime  @default(now())
  sharedVia    String[]  @default([]) // ex. ["email", "whatsapp"]

  lines    PayslipLine[]
  payments Payment[]

  @@unique([staffId, period])
}

// Ligne détaillée d'un bulletin de paie (prime ou retenue nommée), pour un
// document professionnel et transparent plutôt qu'un simple total global.
// Ex. : "Prime de transport" (BONUS), "Cotisation CNSS" (DEDUCTION).
model PayslipLine {
  id        String          @id @default(uuid())
  payslip   Payslip         @relation(fields: [payslipId], references: [id])
  payslipId String
  label     String
  type      PayslipLineType
  amount    Decimal
}

enum PayslipLineType {
  PRIME
  RETENUE
}

enum PayslipStatus {
  GENERE
  PAYE
  PARTAGE
}

// ---------------- Documents & Partage ----------------

model Document {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  project        Project?     @relation(fields: [projectId], references: [id])
  projectId      String?
  title          String
  type           DocumentType
  content        String       // stockage du contenu ou référence vers un fichier (S3)
  visibility     Visibility   @default(PRIVE)
  createdAt      DateTime     @default(now())
  author         User?        @relation(fields: [authorId], references: [id]) // sert de filtre pour l'espace personnel
  authorId       String?

  sharedWith SharedResource[]
}

enum DocumentType {
  TDR
  RAPPORT_ACTIVITE
  RAPPORT_FINANCIER
  AUTRE
}

enum Visibility {
  PRIVE
  PARTAGE
}

// Partage explicite d'un document avec une organisation partenaire sur un projet donné
model SharedResource {
  id             String       @id @default(uuid())
  document       Document     @relation(fields: [documentId], references: [id])
  documentId     String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  sharedAt       DateTime     @default(now())

  @@unique([documentId, organizationId])
}

// ---------------- Traçabilité ----------------

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  userName       String       // capturé au moment de l'action — reste lisible même si l'utilisateur est supprimé plus tard
  action         String       // "CREATE" | "UPDATE" | "DELETE" | "APPROVE" | "REJECT" | ...
  entity         String       // ex. "PurchaseOrder", "PaymentRequest"
  entityId       String
  timestamp      DateTime     @default(now())
  metadata       Json?        // détail (ex. { before, after } ou champs modifiés)
}

// Taux de change saisi manuellement par le Comptable — permet la
// conversion entre devises (GNF/USD/EUR) pour les missions internationales
// et les rapports consolidés multi-devises. Volontairement manuel plutôt
// qu'automatique : un taux de change appliqué à un projet financé par
// subvention doit être celui négocié/approuvé avec le bailleur, pas un taux
// de marché flottant récupéré en temps réel.
model ExchangeRate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fromCurrency   String
  toCurrency     String
  rate           Decimal      // 1 unité de fromCurrency = `rate` unités de toCurrency
  effectiveDate  DateTime     @default(now())
  setById        String?

  @@index([organizationId, fromCurrency, toCurrency, effectiveDate])
}

// Demande de paiement adressée au bailleur — format calqué sur les
// documents réels utilisés par le CAM avec USAID (repère numéroté, montant
// en toutes lettres, justificatifs d'activités, double signature). Distincte
// de `Invoice` (facturation classique à un client/partenaire) : ce document
// suit le cycle propre au financement de projet par subvention.
model PaymentRequest {
  id               String               @id @default(uuid())
  project          Project              @relation(fields: [projectId], references: [id])
  projectId        String
  bankAccount      BankAccount?         @relation(fields: [bankAccountId], references: [id])
  bankAccountId    String?              // compte spécifique à utiliser — sinon le compte par défaut de l'organisation
  repereNumber     Int                  // "REPÈRE N° 2"
  amountRequested  Decimal
  requestDate      DateTime             @default(now())
  achievements     String               // justificatifs (une ligne par réalisation, séparées par \n)
  preparedByName   String
  preparedByTitle  String
  status           PaymentRequestStatus @default(BROUILLON)
  approvedAt       DateTime?
  approvedById     String?
  createdAt        DateTime             @default(now())
}

// Une ONG gère souvent plusieurs projets financés par des bailleurs
// différents, chacun exigeant parfois un compte bancaire dédié — parfois
// dans des banques différentes. Ce modèle permet d'enregistrer autant de
// comptes que nécessaire, chacun sélectionnable au moment de créer une
// demande de paiement.
model BankAccount {
  id             String           @id @default(uuid())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String
  label          String           // ex. "Compte dédié USAID StopPalu"
  bankName       String
  bankAddress    String?
  accountNumber  String
  currency       String           @default("GNF")
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())

  paymentRequests PaymentRequest[]
}

enum PaymentRequestStatus {
  BROUILLON
  APPROUVEE_PRESIDENT
  ENVOYEE_BAILLEUR
  PAYEE
}

// Modèle de lettre réutilisable (bibliothèque). L'organisation part avec un
// jeu initial de modèles courants et peut en créer/modifier/enregistrer
// autant qu'elle veut — la bibliothèque grandit avec l'usage plutôt que
// d'être figée à un nombre arbitraire de modèles pré-écrits.
model LetterTemplate {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  title          String       // ex. "Lettre de transmission de rapport"
  category       String       // ex. "Bailleur", "Fournisseur", "RH", "Partenaire"
  bodySample     String       // corps type avec balises {{destinataire}}, {{objet}}, {{corps}}...
  isSystem       Boolean      @default(false) // modèle fourni par défaut (non supprimable)
  createdAt      DateTime     @default(now())

  letters        Letter[]
}

// Lettre réellement envoyée, générée à partir d'un modèle et complétée.
model Letter {
  id             String          @id @default(uuid())
  organizationId String
  template       LetterTemplate? @relation(fields: [templateId], references: [id])
  templateId     String?
  reference      String?         // ex. "N° 014/CAM/BK/2026"
  recipientTitle String          // ex. "Monsieur le Conseiller Régional du Projet STOPPALU de Boké"
  subject        String
  body           String
  signatoryName  String
  signatoryTitle String
  projectId      String?
  createdAt      DateTime        @default(now())
}
